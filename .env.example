# Arven, variaveis de ambiente. Copie pra .env.local e preencha.
# .env.local e gitignored. Nunca comite segredos.

# ---------- Supabase ----------
# Local: rode `pnpm db:start` e pegue os valores do output.
# Prod: pegue do dashboard Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Nunca exponha. Bypassa RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Integracoes (entram nas fatias 5 e 7) ----------
# Segredo HMAC compartilhado com o Apps Script do Google Form. Use 32+ chars aleatorios.
# GOOGLE_FORM_WEBHOOK_SECRET=

# Segredo do Vercel Cron pra autenticar invocacoes dos jobs.
# CRON_SECRET=
